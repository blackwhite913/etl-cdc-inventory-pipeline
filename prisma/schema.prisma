// Prisma schema for the stock ETL pipeline.
//
// Models:
//   - StockSnapshot : current-state table keyed by (productCode, warehouseCode).
//                     Source of truth for the CDC cursor (MAX(lastModified)).
//   - EtlRun        : observability-only run log. Never feeds CDC decisions.
//   - EtlLock       : per-job lock rows preventing concurrent ETL runs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model StockSnapshot {
  productCode       String
  warehouseCode     String

  description       String?
  productGroup      String?

  qtyOnHand         Int
  allocatedQty      Int
  availableQty      Int
  onPurchase        Int

  avgCost           Float?
  totalCost         Float?

  daysSinceLastSale Int?

  lastModified      DateTime?
  snapshotAt        DateTime  @default(now())

  @@id([productCode, warehouseCode])
  // productCode is already the left-most key of the composite PK index.
  // warehouseCode standalone index supports warehouse-scoped queries.
  @@index([productCode])
  @@index([warehouseCode])
  @@index([lastModified])
}

model EtlRun {
  id                     String    @id @default(cuid())
  startedAt              DateTime  @default(now())
  finishedAt             DateTime?

  mode                   String
  status                 String

  recordsProcessed       Int       @default(0)
  inserted               Int       @default(0)
  updated                Int       @default(0)
  partialFailures        Int       @default(0)

  fetchTimeMs            Int?
  loadTimeMs             Int?
  totalTimeMs            Int?

  cdcCursorUsed          DateTime?
  latestLastModifiedSeen DateTime?

  errorMessage           String?

  @@index([startedAt])
  @@index([status])
}

model EtlLock {
  jobName    String   @id
  acquiredAt DateTime
  expiresAt  DateTime
}

model BomHeader {
  billNumber           String   @id
  productCode          String
  productDescription   String?
  defaultPurchasePrice Float?
  defaultSellPrice     Float?
  totalCost            Float?
  lastModifiedOn       DateTime?
  createdOn            DateTime?

  lines BomLine[]

  @@index([productCode])
  @@index([lastModifiedOn])
}

model BomLine {
  id                   String   @id @default(cuid())
  billNumber           String
  lineNumber           Int
  componentCode        String
  componentDescription String?
  quantity             Float?
  unitCost             Float?
  lastModifiedOn       DateTime?

  header BomHeader @relation(fields: [billNumber], references: [billNumber], onDelete: Cascade)

  @@index([billNumber])
  @@index([componentCode])
}

model ShopifyVariant {
  id                String   @id
  productId         String
  sku               String?
  variantTitle      String?
  productTitle      String?
  vendor            String?
  productType       String?
  tags              String[]
  price             String?
  inventoryQuantity Int?
  status            String?
  updatedAt         DateTime?
  syncedAt          DateTime @default(now())

  @@index([sku])
  @@index([productId])
  @@index([updatedAt])
}

model EtlMetadata {
  jobName   String   @id
  lastRunAt DateTime?
}

model DatasetStatus {
  datasetName   String   @id
  lastUpdatedAt DateTime?
  rowCount      Int      @default(0)
}
