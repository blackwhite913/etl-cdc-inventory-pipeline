{
  "name": "etl-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n NEXT,POLLER -c cyan,magenta \"npm:dev:next\" \"npm:dev:poller\"",
    "dev:next": "next dev",
    "dev:poller": "dotenv -e .env.local -- node scripts/local-etl-poller.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "etl:run": "dotenv -e .env.local -- tsx scripts/run-etl.ts",
    "etl:run:railway": "tsx jobs/run-stock-etl.ts",
    "etl:daily": "tsx jobs/run-daily-etl.ts",
    "etl:stock": "tsx jobs/run-stock-etl.ts",
    "sandbox:shopify-sales": "dotenv -e .env -e .env.local -- node scripts/sandbox-shopify-sales.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "next": "^16.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.4",
    "postcss": "^8",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
